# Chep file nay thanh .env.local (khong dua len git) roi sua gia tri. Doi xong phai chay lai npm run dev.

# Dia chi backend. Chay ca backend tren may nay thi de nguyen.
# Dien thoai / may khac cung Wi-Fi: dung IP may chay backend, vd http://192.168.137.1:8080
VITE_API_URL=http://localhost:8080

# CHI dat tren Pi (hop nhac): VITE_DEVICE_ID=box. Laptop / dien thoai de trong.
VITE_DEVICE_ID=
